# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only used in trusted server contexts (never exposed to the client). Not required for Phase 1.
SUPABASE_SERVICE_ROLE_KEY=

# Discord OAuth is configured in the Supabase dashboard (Authentication -> Providers -> Discord)
# using a Client ID / Secret from https://discord.com/developers/applications.
# No app-level env vars are needed for it beyond the Supabase project config.

# External community + booking links
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/ZGJm8vKUbz
NEXT_PUBLIC_CALENDLY_URL=

# Merch: external store link-out only (no store code in this app, per Phase 4 scope note)
NEXT_PUBLIC_MERCH_URL=

# Phase 2: link to Mochi's published TradingView scripts/profile
NEXT_PUBLIC_TRADINGVIEW_PROFILE_URL=

# Email provider (stubbed behind lib/email.ts until a real key is wired up)
RESEND_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
